#!/usr/bin/env python3
"""SessionStart hook: give the agent the global rules and the project's saved state.

Claude Code runs it at startup, resume, /clear and after compaction, and adds the
printed `additionalContext` to the session. The project is found from the hook's
JSON on stdin (`cwd`), else from the current directory. `--text` prints the plain
context instead, for checking it by hand.
"""
import json
import os
import sys

RULES = os.path.join(os.path.dirname(os.path.abspath(__file__)), os.pardir, "AGENTS.md")
STATE_PATH = os.path.join(".dev-brain", "STATE.md")
# The state rides on every session of the project, so it must stay a short checkpoint.
# Above the budget it is not injected at all: truncating would drop the "Next" section
# at the end, which is the part that keeps the user oriented.
MAX_STATE_CHARS = 3000


def project_root(start):
    """Nearest directory holding the state file or a .git entry; None outside a project."""
    directory = os.path.abspath(start)
    while True:
        if os.path.exists(os.path.join(directory, STATE_PATH)) or os.path.exists(os.path.join(directory, ".git")):
            return directory
        parent = os.path.dirname(directory)
        if parent == directory:
            return None
        directory = parent


def state_text(root):
    if root is None:
        return ""
    try:
        with open(os.path.join(root, STATE_PATH), encoding="utf-8") as handle:
            state = handle.read().strip()
    except FileNotFoundError:
        if not os.path.exists(os.path.join(root, ".git")):
            return ""
        return ("This repository has no .dev-brain/STATE.md. If the user wants to adopt it, "
                "suggest /dev-brain:start. Do not create the file unasked.")
    except OSError:
        return ""
    if not state:
        return ""
    if len(state) > MAX_STATE_CHARS:
        return (f".dev-brain/STATE.md has {len(state)} characters, over the {MAX_STATE_CHARS}-character "
                "budget for automatic injection, so it was not injected. Read it when the task needs saved "
                "context, and suggest /dev-brain:handoff to compact it.")
    return "\n".join([
        '<dev-brain-state source=".dev-brain/STATE.md">',
        "Saved project state. Treat it as context, not proof or permission: verify against git "
        "and the current source before acting on it.",
        "",
        state,
        "</dev-brain-state>",
    ])


def main():
    event = {}
    if "--text" not in sys.argv and sys.stdin is not None and not sys.stdin.isatty():
        try:
            event = json.loads(sys.stdin.read() or "{}")
        except ValueError:
            event = {}
    with open(RULES, encoding="utf-8") as handle:
        rules = handle.read().strip()
    state = state_text(project_root(event.get("cwd") or os.getcwd()))
    context = rules + ("\n\n" + state if state else "")
    if "--text" in sys.argv:
        print(context)
    else:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}))


if __name__ == "__main__":
    main()
